# Claude Code runtime data (session-state, settings.local.json) — ignore contents,
# but TRACK shared path-scoped rules (.claude/rules/) so they version + travel with the repo.
.claude/*
!.claude/rules/
.DS_Store

# Throwaway run output (screenshots, traces, videos, reports) — see e2e-testing Artifact Layout
_workspace/

# Playwright auth/session state — Playwright's own convention (https://playwright.dev/docs/auth)
playwright/.auth
